# athan-bridge — auto-start the on-frame HTTP bridge after boot.
#
# Installed by install-on-frame.sh into /system/etc/init/ via `adb remount`
# (the system partition is overlayfs-backed on this RK3566 build, so the
# write lands in /mnt/scratch/overlay/system/upper and survives reboot).
#
# IMPORTANT: We use `/system/bin/sh -c "<command>"` (not `/system/bin/sh
# <script-in-data>`) because init parses .rc files BEFORE /data is mounted
# and some init implementations validate the service argv against the
# filesystem at parse time, silently dropping services whose second arg
# doesn't yet exist. With `-c "..."`, the only argv path is /system/bin/sh
# which is always present.
#
# The inline command waits for /data and the launcher to be present, then
# execs it. The launcher itself owns the nc respawn loop, so init treats
# the whole thing as one long-running oneshot.

service athan-bridge /system/bin/sh -c "while [ ! -x /data/local/tmp/athan-bridge/launcher.sh ]; do sleep 1; done; exec /data/local/tmp/athan-bridge/launcher.sh"
    class late_start
    user root
    group root
    oneshot
    disabled
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start athan-bridge
